# ─── Telegram Bot ───────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# ─── Live Trading Controls ────────────────────────────────────────────────────
# Max concurrent open positions. Signals still fire when cap is reached,
# but message includes [CAP REACHED] warning.
MAX_CONCURRENT_POSITIONS=20

# S&P 500 position cap (defaults to MAX_CONCURRENT_POSITIONS if unset).
SP500_MAX_CONCURRENT_POSITIONS=20

# ─── Dashboard ───────────────────────────────────────────────────────────────
DASHBOARD_PORT=8502

# ─── Paths (defaults work for both Docker and local dev) ──────────────────────
DB_PATH=./data/trading.db
CACHE_DIR=./data/cache

# ─── Insider-Trade Cluster Swing System (InsiderSwing) ───────────────────────
# Data source: 'edgar' (free, complete, carries the Rule 10b5-1 checkbox),
# 'fmp' (needs a paid plan for per-symbol history), or 'auto'.
INSIDER_SOURCE=edgar

# REQUIRED for the EDGAR path. The SEC mandates a descriptive User-Agent with a
# real contact address on every request; anonymous requests get blocked.
INSIDER_SEC_USER_AGENT=YourName YourProject (your.email@example.com)
INSIDER_SEC_RATE_LIMIT=8          # req/s — SEC's published ceiling is 10

# Only needed if INSIDER_SOURCE is fmp or auto.
FMP_API_KEY=

# Signal construction
INSIDER_CLUSTER_WINDOW_DAYS=45
INSIDER_CONVICTION_THRESHOLD=60
INSIDER_MIN_TRADE_VALUE=25000
INSIDER_CONFIRMATION_WINDOW_DAYS=15
INSIDER_TRIGGER_TYPES=dma_reclaim,range_breakout,rsi_reset

# Risk
INSIDER_ACCOUNT_SIZE=100000
INSIDER_RISK_PERCENT=1
INSIDER_MAX_CAPITAL_PCT=10
INSIDER_MAX_CONCURRENT_POSITIONS=10
INSIDER_TIME_STOP_DAYS=20
INSIDER_MIN_ADV_USD=2000000

# Backtest
INSIDER_BACKTEST_START=2016-01-01
INSIDER_DB_PATH=./data/insider_swing.db

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
